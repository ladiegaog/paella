{
  "name": "paella",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "types": "wrangler types --include-runtime=false",
    "vendor": "node scripts/vendor.mjs",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create paella-db",
    "db:migrate": "wrangler d1 migrations apply paella-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply paella-db --remote",
    "db:adoptar": "wrangler d1 execute paella-db --local --file=scripts/adoptar-migraciones.sql",
    "db:adoptar:remote": "wrangler d1 execute paella-db --remote --file=scripts/adoptar-migraciones.sql",
    "r2:create": "wrangler r2 bucket create paella-storage"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@jsquash/webp": "1.5.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
